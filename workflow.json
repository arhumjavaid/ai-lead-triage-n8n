      "id": "23e9ac69-0d13-4cb7-bbd7-3103cbbd1368",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -896,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.model }}\",\n  \"temperature\": 0.2,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n\"content\": \"You are a B2B lead qualification assistant for a software development studio. Score each inbound lead from 0 to 10 on how likely it is to become a paying client. Consider budget, clarity of the request, whether it matches software/automation work, and signs of spam. Return ONLY a JSON object with exactly these keys: score (number 0-10), category (one of hot, warm, cold, or spam), reasoning (one short sentence), and suggested_reply (a friendly two-sentence first reply addressed to the lead by first name). No markdown, no code fences, no text outside the JSON object.\nScore primarily on how specific and actionable the described\nneed is, and how well it fits software, automation, or AI work.\nThe stated budget is a secondary signal.\n\nIf the message does not describe a concrete problem or project,\nThe score must not exceed 5, regardless of the stated budget.\n\nAcademic, research, and interview requests are cold (2 or below)\nhowever professionally written.\n\nOffers of equity, revenue share, or exposure in place of payment\ncap the score at 3.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"Name: \" + $json.Name + \" | Email: \" + $json.Email + \" | Company: \" + ($json.Company || \"not given\") + \" | Budget: \" + ($json.Budget || \"not given\") + \" | Message: \" + $json.Message) }}\n    }\n  ]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "7ec297c2-df09-4524-a765-596f96824ae7",
      "name": "Qualify Lead (Groq)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -672,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i];\n  const lead = $('Set Config').all()[i].json;\n\n  const raw = item.json?.choices?.[0]?.message?.content ?? '';\n\n  let parsed = null;\n  let parseOk = true;\n  let parseError = '';\n\n  try {\n    if (!raw) throw new Error('Empty response from model');\n    const cleaned = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n    if (typeof parsed.score !== 'number') throw new Error('score missing or not a number');\n    if (!parsed.category) throw new Error('category missing');\n    if (parsed.score < 0 || parsed.score > 10) throw new Error('score out of range');\n  } catch (e) {\n    parseOk = false;\n    parseError = e.message;\n  }\n\n  out.push({\n    json: {\n      receivedAt: new Date().toISOString(),\n      name: lead.Name ?? '',\n      email: lead.Email ?? '',\n      company: lead.Company ?? '',\n      budget: lead.Budget ?? '',\n      message: lead.Message ?? '',\n      scoreThreshold: lead.scoreThreshold ?? 7,\n      parseOk,\n      parseError,\n      score: parsed?.score ?? null,\n      category: parsed?.category ?? null,\n      reasoning: parsed?.reasoning ?? null,\n      suggestedReply: parsed?.suggested_reply ?? null,\n      rawModelOutput: raw\n    }\n  });\n}\n\nreturn out;"
      },
